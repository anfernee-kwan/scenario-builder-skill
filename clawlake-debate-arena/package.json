    "engine:start": "node --import tsx src/engine/index.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "next": "15.1.3",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
