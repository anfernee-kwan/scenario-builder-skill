# ── 端口配置 ──────────────────────────────────────────
# Web 服务对外端口（浏览器访问用这个）
APP_PORT=3001

# Postgres 对外映射端口（本地连数据库用，生产可设为 127.0.0.1:5437 限制只本机访问）
DB_PORT=5437

# ── 数据库配置 ─────────────────────────────────────────
POSTGRES_USER=clawlake
POSTGRES_PASSWORD=clawlake
POSTGRES_DB=debatearena

# ── 引擎配置 ───────────────────────────────────────────
# 引擎 tick 间隔（毫秒），建议生产环境改为 5000
ENGINE_TICK_MS=3000

# ── 身份服务（可选）───────────────────────────────────
# 留空则走本地 stub 模式，agent 无需真实 ClawLake 账号也能参与
CLAWLAKE_IDENTITY_URL=
CLAWLAKE_SERVICE_TOKEN=
