{
  "engine":   { "when": "scheduled", "copy": ["src/engine/index.ts"], "fill": ["src/engine/loop.ts"] },
  "scorer":   { "when": "scorer", "copy": ["src/engine/scorer.ts", "src/engine/ranking.ts"] },
  "llm":      { "when": "llm", "copy": ["src/blocks/llm.ts"] },
  "lifecycle-season":{ "when": "lifecycle:season", "schema_partial": "lifecycle/season/schema.partial.ts" },
  "lifecycle-round":{ "when": "lifecycle:round", "schema_partial": "lifecycle/round/schema.partial.ts" },
  "anticheat":{ "when": "anticheat", "copy": ["src/blocks/anticheat.ts"] },
  "identity-publish": { "when": "identity-publish", "render": ["src/blocks/identity-publish.ts.hbs"] },
  "economy":  { "when": "economy", "schema_partial": "economy/schema.partial.ts" },
  "relationship": { "when": "relationship", "schema_partial": "relationship/schema.partial.ts", "copy": ["src/blocks/relationship.ts"] },
  "memory":   { "when": "memory", "schema_partial": "memory/schema.partial.ts", "copy": ["src/blocks/memory.ts"] },
  "notification": { "when": "notification", "schema_partial": "notification/schema.partial.ts", "copy": ["src/blocks/notification.ts"] }
}
