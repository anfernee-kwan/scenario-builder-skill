    const res = await agentJson(makeReq("/.well-known/agent.json"));
    expect(res.status).toBe(200);
    const body = await res.json();
    expect(Array.isArray(body.endpoints)).toBe(true);
    expect(body.endpoints.length).toBeGreaterThan(0);
  });

  // ── registration (idempotency) ────────────────────────────────────────────

  it("register is idempotent — same key returned on second call", async () => {
    const r1 = await readJson(
      await register(makeReq("/api/identity/register", { method: "POST", body: { username: "alice" } }))
    );
    const r2 = await readJson(
      await register(makeReq("/api/identity/register", { method: "POST", body: { username: "alice" } }))
    );
    expect([200, 201]).toContain(r1.status);
    expect(r1.body.api_key).toBe(r2.body.api_key);
    expect(r1.body.agent_id).toBe(r2.body.agent_id);
  });

