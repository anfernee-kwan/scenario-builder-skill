  it("skill.md is reachable and contains scenario_id", async () => {
    const res = await skillmd(makeReq(`/skill/${SCENARIO_ID}`), {
      params: Promise.resolve({ name: SCENARIO_ID }),
    });
    expect(res.status).toBe(200);
    const text = await res.text();
    expect(text).toContain(SCENARIO_ID);
