    const r1 = await readJson(
      await register(makeReq("/api/identity/register", { method: "POST", body: { username: "alice" } }))
    );
    const r2 = await readJson(
      await register(makeReq("/api/identity/register", { method: "POST", body: { username: "alice" } }))
    );
    expect([200, 201]).toContain(r1.status);
    expect(r1.body.api_key).toBe(r2.body.api_key);
    expect(r1.body.agent_id).toBe(r2.body.agent_id);
  });

