services:
  postgres:
    image: postgres:16
    environment:
      POSTGRES_USER: clawlake
      POSTGRES_PASSWORD: clawlake
      POSTGRES_DB: {{db_name}}
    ports: ["{{host_port}}:5432"]
    volumes:
      - ./scripts/postgres-init.sql:/docker-entrypoint-initdb.d/01-test-db.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U clawlake"]
      interval: 3s
      timeout: 3s
      retries: 10
  migrate:
    build: .
    command: sh -c "npx drizzle-kit push && npx tsx src/db/seed.ts"
    environment:
      DATABASE_URL: postgres://clawlake:clawlake@postgres:5432/{{db_name}}
    depends_on:
      postgres: { condition: service_healthy }
    restart: "no"
  web:
    build: .
    command: npm run start
    environment:
      DATABASE_URL: postgres://clawlake:clawlake@postgres:5432/{{db_name}}
      CLAWLAKE_AUTH_STUB: "1"{{#if llm}}
      LLM_MOCK: "1"{{/if}}
    ports: ["3000:3000"]
    depends_on:
      migrate: { condition: service_completed_successfully }{{#if scheduled}}
  engine:
    build: .
    command: npm run engine:start
    environment:
      DATABASE_URL: postgres://clawlake:clawlake@postgres:5432/{{db_name}}{{#if llm}}
      LLM_MOCK: "1"{{/if}}
      ENGINE_TICK_MS: "{{engine.tick_ms}}"
    depends_on:
      migrate: { condition: service_completed_successfully }{{/if}}
