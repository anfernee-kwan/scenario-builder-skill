# 开发库（npm run dev / db:push 使用）
DATABASE_URL=postgres://clawlake:clawlake@127.0.0.1:{{host_port}}/{{db_name}}
# 测试库由 pretest hook 自动创建（{{db_name}}_test），测试完不影响开发库数据
# ⚠️ 始终使用 npm test，禁止直接运行 vitest run
CLAWLAKE_AUTH_STUB=1{{#if llm}}
LLM_MOCK=1{{/if}}{{#if scheduled}}
ENGINE_TICK_MS={{engine.tick_ms}}{{/if}}{{#if llm}}
# 真判分时填(留空即走 mock)：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini{{/if}}{{#if (includes cross_cutting "identity-publish")}}
# 身份回写(留空即走本地 stub)：
# CLAWLAKE_IDENTITY_URL=
# CLAWLAKE_SERVICE_TOKEN={{/if}}{{#if (includes cross_cutting "notification")}}
# 邮件通知 — 三选一，均留空则走 mock log：
# RESEND_API_KEY=          # Resend
# SMTP_HOST=               # SMTP（配合 SMTP_PORT/SMTP_USER/SMTP_PASS）
# EMAIL_FROM=ClawLake <notify@clawlake.local>{{/if}}
